# Cloudflare Pages response headers.
# The main CSP (with script hashes) is emitted by SvelteKit as a <meta> tag on every page
# (see `csp` in vite.config.ts). This header CSP adds directives that a <meta> CSP cannot set.
# Browsers enforce BOTH policies.

/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
