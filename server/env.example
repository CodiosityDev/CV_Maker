# CV Maker AI API — settings. Copy to the VPS as
#   /home/el/web/cvmaker.codiosity.com/private/cvmaker-api.env   (permissions 600)
# NEVER commit the real file or paste its values anywhere.

# Random string, at least 32 characters (e.g. from a password generator).
# Signs device tokens and hashes IPs. Changing it resets every device's token (not the quota).
APP_SECRET=

# The owner's OpenAI-compatible router. Base URL usually ends with /v1.
AI_BASE_URL=
AI_API_KEY=
# Tried in order; the next is used when one fails or is slow.
AI_MODELS=cx/gpt-6.1-terra
AI_TIMEOUT_MS=30000

# MySQL database from the Hestia panel.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=el_cvmaker
DB_USER=el_cvmaker
DB_PASSWORD=

# Daily limits (reset 00:00 WIB). Device = the owner's "3x per day".
AI_LIMIT_DEVICE=3
AI_LIMIT_IP=30
AI_LIMIT_DEVICES_PER_IP=10
AI_LIMIT_GLOBAL=1500

PORT=8787
APP_ORIGIN=https://cvmaker.codiosity.com
