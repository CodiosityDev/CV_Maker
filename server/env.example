# CV Maker AI API — settings. Copy to the VPS as
#   /home/el/web/cvmaker.codiosity.com/private/cvmaker-api.env   (permissions 600)
# NEVER commit the real file or paste its values anywhere.

# Random string, at least 32 characters (e.g. from a password generator).
# Signs device tokens and hashes IPs. Changing it resets every device's token (not the quota).
APP_SECRET=

# The owner's OpenAI-compatible router. Base URL usually ends with /v1.
AI_BASE_URL=
AI_API_KEY=
# Tried in order; the next is used when one fails or is slow.
AI_MODELS=cx/gpt-6.1-terra
AI_TIMEOUT_MS=30000

# MySQL database from the Hestia panel.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=el_cvmaker
DB_USER=el_cvmaker
DB_PASSWORD=

# Daily limits (reset 00:00 WIB). Device = the owner's "3x per day".
AI_LIMIT_DEVICE=3
AI_LIMIT_IP=100
AI_LIMIT_DEVICES_PER_IP=10
AI_LIMIT_GLOBAL=1500
# Visitor counter: new visitors counted per IP per day (stops scripts inflating it).
VISITOR_LIMIT_IP=300

PORT=8787
APP_ORIGIN=https://cvmaker.codiosity.com

# Rewarded ads: watch an ad for +1 AI use (owner: max 10 per device per day).
# Keep false until Google Ad Manager's rewarded unit is set in adsite/config.js and
# https://iklan.codiosity.com is live.
ADS_ENABLED=false
ADS_ORIGIN=https://iklan.codiosity.com
AI_LIMIT_REWARDS=10
AI_LIMIT_REWARDS_IP=100
AI_REWARD_MIN_SECONDS=15

# --- Accounts (optional; each login method is off until its settings are filled) ---
# Google sign-in: Google Cloud → Google Auth Platform → Clients → "Web application".
# Authorized redirect URI: https://cvmaker.codiosity.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email + password sign-up needs mail for verification and password reset links.
# A mailbox from Hestia (Mail → codiosity.com → noreply). Port 587 = STARTTLS, 465 = TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CV Maker <noreply@codiosity.com>

# Cloud backups for logged-in users (max 3 CVs each, so a few MB is plenty). Oldest versions make room.
# BACKUP_TOTAL_GB caps all users together so the VPS disk cannot fill up.
BACKUP_USER_MB=5
BACKUP_TOTAL_GB=20
